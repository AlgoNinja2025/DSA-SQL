class Solution {
    public int minimumDeletions(int[] nums) {
        int n = nums.length;
        int maxidx = 0;
        int minidx = 0;
        
        // 1. Find the actual min and max indices first
        for (int i = 0; i < n; i++) {
            if (nums[i] < nums[minidx]) minidx = i;
            if (nums[i] > nums[maxidx]) maxidx = i; // maxid to maxidx
        }

        // 2. Perform calculations AFTER the loop finishes
        int left = Math.min(minidx, maxidx);
        int right = Math.max(minidx, maxidx);

        int front = right + 1;
        int back = n - left;
        int both = (left + 1) + (n - right);

        // 3. Chain Math.min to compare three numbers
        return Math.min(front, Math.min(back, both));
    }
}
